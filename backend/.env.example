# Incendium backend configuration.
# Copy to `backend/.env` (git-ignored) only if you do NOT already have these set as
# Windows user environment variables. Never commit real values.

# --- Mandatory credentials -------------------------------------------------
# NASA FIRMS MAP_KEY (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# Copernicus Data Space OAuth client (free):
# https://shapps.dataspace.copernicus.eu/dashboard/#/account/settings -> OAuth clients
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Optional settings (defaults shown) ------------------------------------
# INCENDIUM_DB_PATH=instance/incendium.sqlite3
# Comma-separated region ids from incendium/data/regions.json that get a risk grid.
# INCENDIUM_RISK_REGIONS=karnataka
# INCENDIUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Run ingestion jobs inside the API process (1/0).
# INCENDIUM_SCHEDULER=1
# Allow POST /api/admin/refresh/<job> from localhost only (1/0).
# INCENDIUM_ALLOW_MANUAL_REFRESH=1
# Experimental composite weights (must sum to 1.0): T,H,W,D,V
# INCENDIUM_COMPOSITE_WEIGHTS=0.25,0.25,0.20,0.15,0.15
# Older EMBER_* names for the settings above are still read as a fallback.

# --- Optional: alert notifications (Module 5) -------------------------------
# Incendium never contacts authorities automatically. Notifications go only to the
# recipients configured here. On the VPS these lines live in /etc/incendium.env
# (root:incendium, mode 640), never in git. Restart the service after changes:
#   systemctl restart incendium
#
# Master switch for ALL alert emails (Fire Risk Index alerts and detection alerts): 1/0
# INCENDIUM_EMAIL_ENABLED=0
# Test mode: build the emails but write them to backend/instance/outbox/ instead of sending: 1/0
# INCENDIUM_EMAIL_TEST_MODE=0
#
# Fire Risk Index alert (composite score 0-100; classes Low <25, Moderate <50, High <75, Very High >=75).
# An email is sent when a cell's index rises from below to at/above this value.
# INCENDIUM_FIRE_ALERT_THRESHOLD=75
# Minimum hours between two emails for the same cell, even if it re-crosses.
# INCENDIUM_ALERT_COOLDOWN_HOURS=12
# Link included in the email.
# INCENDIUM_PUBLIC_URL=https://162.35.42.114
#
# Recipients (comma-separated) and/or a file with one address per line (# comments allowed):
# INCENDIUM_ALERT_EMAIL_TO=you@example.org,colleague@example.org
# INCENDIUM_ALERT_RECIPIENTS_FILE=/etc/incendium-recipients.txt
#
# Sender account (SMTP). Gmail: smtp.gmail.com, port 587, your Gmail address as user,
# and a 16-character Google App Password (requires 2-Step Verification), NOT your normal password.
# INCENDIUM_SMTP_HOST=smtp.gmail.com
# INCENDIUM_SMTP_PORT=587
# INCENDIUM_SMTP_USER=sender@gmail.com
# INCENDIUM_SMTP_PASSWORD=
# INCENDIUM_SMTP_FROM=Incendium Alerts <sender@gmail.com>
#
# Detection alerts (existing): JSON POST to a webhook you control, and the lowest priority emailed.
# INCENDIUM_ALERT_WEBHOOK_URL=
# INCENDIUM_ALERT_MIN_PRIORITY=medium
